{
  "name": "voltflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/apk-manifest.mjs",
    "dev": "vite",
    "build": "node scripts/apk-manifest.mjs && vite build",
    "preview": "vite preview",
    "build:android": "vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew :app:assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew :app:assembleRelease",
    "apk:manifest": "node scripts/apk-manifest.mjs",
    "lint": "eslint .",
    "test": "node --test"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/share": "^7.0.3",
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@eslint/js": "^9.38.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.38.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.0",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.2.0"
  }
}
